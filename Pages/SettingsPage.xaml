<Page x:Class="KleopatraKindomTweaker.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svc="clr-namespace:KleopatraKindomTweaker.Services">
    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsTitle]}"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeSectionTitle]}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DarkThemeButton]}"
                            Padding="14,8" Margin="0,0,8,0" Click="Dark_Click"/>
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LightThemeButton]}"
                            Padding="14,8" Click="Light_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LanguageSectionTitle]}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangRuOption" GroupName="Lang" Margin="0,0,18,0" VerticalAlignment="Center"
                                 Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LangRu]}"
                                 Checked="LangRu_Checked" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="LangEnOption" GroupName="Lang" Margin="0,0,18,0" VerticalAlignment="Center"
                                 Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LangEn]}"
                                 Checked="LangEn_Checked" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="LangUkOption" GroupName="Lang" VerticalAlignment="Center"
                                 Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LangUk]}"
                                 Checked="LangUk_Checked" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AboutSectionTitle]}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/app.ico" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AboutText]}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
