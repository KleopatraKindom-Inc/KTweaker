<Page x:Class="KleopatraKindomTweaker.Pages.ProcessManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svc="clr-namespace:KleopatraKindomTweaker.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ProcessesTitle]}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Grid.Column="1"
                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[RefreshButton]}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Refresh_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="ProcessGrid" Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColPid]}" Binding="{Binding Pid}" Width="70"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColName]}" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColWindowTitle]}" Binding="{Binding WindowTitle}" Width="260"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColMemory]}" Binding="{Binding MemoryMb}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColPriority]}" Binding="{Binding Priority}" Width="120"/>
                    <DataGridTemplateColumn Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColActions]}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[BtnKill]}"
                                            Margin="0,0,8,0" Padding="10,5"
                                            Click="Kill_Click" Tag="{Binding}"/>
                                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[BtnHighPriority]}"
                                            Padding="10,5"
                                            Click="SetHighPriority_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
