<Page x:Class="KleopatraKindomTweaker.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svc="clr-namespace:KleopatraKindomTweaker.Services">
    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DashboardTitle]}"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[QuickOptimizeTitle]}"
                           FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[QuickOptimizeDesc]}"/>
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[QuickOptimizeButton]}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Click="QuickOptimize_Click"/>
                <TextBlock x:Name="QuickStatusText" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SystemCardTitle]}"
                           FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
